{
  "schema_version": "aiogym.experiment.v1",
  "name": "cascade-sac-early-diagnostics-v2",
  "description": "Short Cascade v2 SAC diagnostic with frequent validation.",
  "output_dir": "runs/experiments/cascade-sac-early-diagnostics-v2",
  "seeds": [0, 1, 2],
  "training": {
  "schema_version": "aiogym.rl_training_config.v3",
  "track_id": "cascade-regulation-generalist-v2",
  "algorithm_id": "sac",
  "budget": {"unit": "environment_transitions", "value": 60000},
  "n_envs": 1,
  "device": "cpu",
  "algorithm": {
    "batch_size": 256,
    "gamma": 0.99,
    "learning_rate": 0.0001,
    "policy": "MlpPolicy",
    "policy_kwargs": {
      "activation_fn": "relu",
      "net_arch": {"pi": [256, 256], "qf": [256, 256]}
    },
    "rollout_vector_steps": 1,
    "subproc_start_method": "spawn",
    "tau": 0.005,
    "ent_coef": "auto",
    "target_entropy": "auto",
    "tensorboard_log": null,
    "torch_threads": 2,
    "utd_ratio": 1.0,
    "vector_backend": "dummy",
    "verbose": 1
  },
  "replay": {"capacity": 500000, "learning_starts": 2000},
  "evaluation": {"every_transitions": 2000},
  "checkpointing": {"every_transitions": 10000},
  "output": {
    "onnx": false,
    "save_rollout": true,
    "strict_export": false
  },
  "validation_seeds": [5000],
  "resume_mode": "restart_episode",
  "resume_checkpoint": null,
  "dataset_id": null,
  "dataset_path": null,
  "dataset_hash": null,
  "curriculum_id": null,
  "migration_metadata": null
  }
}

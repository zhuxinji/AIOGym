{
  "schema_version": "aiogym.case_profile.v2",
  "name": "continuous-benchmark",
  "scenario": "cascade",
  "status": "assumed-benchmark",
  "description": "Deterministic continuous-production benchmark with a recoverable feed-capacity loss, using an assumed test throughput rather than a verified equipment rating.",
  "specialist_metadata": {
    "controllers": {
      "oracle": {
        "profile": "cascade-control-benchmark",
        "goal": "economic",
        "reward_spec": "economic-v1",
        "parameters": {
          "solve_every": 60,
          "ipopt_max_iter": 80
        }
      }
    }
  },
  "environment": {
    "control_dt": 0.5,
    "episode_steps": 600,
    "action_mode": "actuator",
    "auto_events": false,
    "randomize": false,
    "randomize_setpoints": false,
    "randomize_plant": false,
    "plant_drift": false,
    "integral_obs": false,
    "terminate_on_runaway": false,
    "noise": false
  },
  "operation": {
    "product_flow_sp": 0.0004,
    "min_product_flow": 0.0004
  },
  "initialization": {
    "state": [0.45, 35.0, 0.45, 50.0, 0.45, 65.0],
    "basis": "model-consistent nominal continuous equilibrium"
  },
  "setpoints": {
    "initial": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0],
    "schedule": []
  },
  "disturbances": [
    {
      "at_step": 100,
      "name": "pump_flow_factor",
      "value": 0.7,
      "description": "recoverable 30% feed-pump capacity loss"
    },
    {
      "at_step": 400,
      "name": "pump_flow_factor",
      "value": 1.0,
      "description": "feed-pump capacity restored"
    }
  ],
  "constraints": {
    "product_flow_shortfall": "penalized below min_product_flow"
  },
  "acceptance": {
    "throughput_status": "assumed-benchmark-not-device-rating",
    "metrics": {
      "constraint_violation_count": {"max": 0.0},
      "action_violation_count": {"max": 0.0},
      "runaway_count": {"max": 0.0},
      "controller_solver_limited_count": {"max": 0.0},
      "controller_solver_failure_count": {"max": 0.0},
      "controller_fallback_count": {"max": 0.0}
    }
  },
  "references": []
}

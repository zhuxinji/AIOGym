{
  "schema_version": "aiogym.case_profile.v2",
  "name": "commissioning",
  "scenario": "cascade",
  "status": "benchmark-designed",
  "description": "Deterministic cold, low-inventory startup with staged heating to the nominal open-cascade production state.",
  "specialist_metadata": {
    "controllers": {
      "pid": {"profile": "cascade-control-benchmark"},
      "oracle": {"profile": "cascade-commissioning"}
    }
  },
  "environment": {
    "control_dt": 0.5,
    "episode_steps": 1600,
    "action_mode": "actuator",
    "auto_events": false,
    "randomize": false,
    "randomize_setpoints": false,
    "randomize_plant": false,
    "plant_drift": false,
    "integral_obs": false,
    "terminate_on_runaway": false,
    "noise": false,
    "noise_pct": 0.01
  },
  "operation": {
    "product_flow_sp": 0.0004,
    "min_product_flow": 0.0004
  },
  "initialization": {
    "state": [0.12, 20.0, 0.12, 20.0, 0.12, 20.0],
    "basis": "AIO-Gym benchmark-designed cold startup condition with all tanks above the heater low-level interlock and below the nominal inventory target"
  },
  "setpoints": {
    "initial": [0.45, 0.45, 0.45, 25.0, 30.0, 35.0],
    "schedule": [
      {
        "at_step": 400,
        "values": [0.45, 0.45, 0.45, 30.0, 40.0, 50.0],
        "description": "raise the thermal profile after the initial filling and warm-up stage"
      },
      {
        "at_step": 800,
        "values": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0],
        "description": "establish the nominal production temperature profile"
      }
    ]
  },
  "disturbances": [],
  "constraints": [
    {"name": "tank_levels", "bounds": [0.0, 0.8], "unit": "m"},
    {"name": "heater_min_level", "bounds": [0.05, 0.8], "unit": "m"},
    {"name": "tank_temperatures", "bounds": [0.0, 92.0], "unit": "degC"}
  ],
  "acceptance": {
    "required_checks": [
      "cold_low_inventory_start",
      "heater_interlock_clear_at_start",
      "finite_startup_rollout",
      "staged_thermal_targets_are_reachable",
      "nominal_production_state_reached",
      "constraint_accounting"
    ],
    "metrics": {
      "tracking_iae": {"max": 130.0},
      "tracking_settling_time": {"max": 700.0},
      "tracking_overshoot": {"max": 0.08},
      "energy_kwh": {"max": 30.0},
      "constraint_violation_count": {"max": 0.0},
      "constraint_violation_severity": {"max": 0.0},
      "action_violation_count": {"max": 0.0},
      "runaway_count": {"max": 0.0},
      "controller_solver_limited_count": {"max": 0.0},
      "controller_solver_failure_count": {"max": 0.0},
      "controller_fallback_count": {"max": 0.0}
    }
  },
  "references": []
}

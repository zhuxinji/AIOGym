{
  "schema_version": "aiogym.task_profile.v1",
  "name": "safety-recovery",
  "scenario": "cascade",
  "status": "benchmark-designed",
  "description": "Recoverable open-cascade case starting with Tank 0 low-level heater protection and Tank 2 temperature-trip protection active.",
  "default_objective": "safety",
  "supported_objectives": ["tracking", "kpi", "robustness", "safety"],
  "controllers": {
    "pid": {"profile": "cascade-control-benchmark"}
  },
  "environment": {
    "control_dt": 0.1,
    "episode_steps": 600,
    "action_mode": "actuator",
    "auto_events": false,
    "randomize": false,
    "randomize_setpoints": false,
    "randomize_plant": false,
    "plant_drift": false,
    "integral_obs": false,
    "terminate_on_runaway": false,
    "noise": false,
    "noise_pct": 0.01
  },
  "operation": {
    "product_flow_sp": 0.0004,
    "min_product_flow": 0.0004
  },
  "initialization": {
    "state": [0.04, 35.0, 0.45, 50.0, 0.45, 93.0],
    "basis": "AIO-Gym software safety-recovery condition below the 0.05 m heater minimum level and above the 92 degC heater trip, but inside hard state limits"
  },
  "setpoints": {
    "initial": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0],
    "schedule": []
  },
  "disturbances": [],
  "constraints": [
    {"name": "hard_level_bounds", "bounds": [0.0, 0.8], "unit": "m"},
    {"name": "heater_min_level", "bounds": [0.05, 0.8], "unit": "m"},
    {"name": "heater_temperature_trip", "bounds": [0.0, 92.0], "unit": "degC"},
    {"name": "hard_temperature_bounds", "bounds": [0.0, 120.0], "unit": "degC"}
  ],
  "acceptance": {
    "required_checks": [
      "low_level_heater_interlock",
      "temperature_trip_interlock",
      "recoverable_without_hard_termination",
      "structured_protection_state",
      "hard_boundary_separation"
    ]
  },
  "references": [
    {
      "id": "cascade-software-protection-contract",
      "locator": "aiogym/models/scenarios/cascade.py; numerical initial state is benchmark-designed"
    }
  ]
}

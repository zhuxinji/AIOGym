{
  "schema_version": "aiogym.task_profile.v1",
  "name": "commissioning",
  "scenario": "cascade",
  "status": "assumed-benchmark",
  "description": "Deterministic hold test at the model-consistent 0.4 L/s open-cascade equilibrium.",
  "default_objective": "tracking",
  "supported_objectives": ["tracking", "kpi", "robustness", "safety"],
  "controllers": {
    "pid": {"profile": "cascade-control-benchmark"}
  },
  "environment": {
    "control_dt": 0.5,
    "episode_steps": 600,
    "action_mode": "actuator",
    "auto_events": false,
    "randomize": false,
    "randomize_setpoints": false,
    "randomize_plant": false,
    "plant_drift": false,
    "integral_obs": false,
    "terminate_on_runaway": false,
    "noise": false,
    "noise_pct": 0.01
  },
  "operation": {
    "product_flow_sp": 0.0004,
    "min_product_flow": 0.0004
  },
  "initialization": {
    "state": [0.45, 35.0, 0.45, 50.0, 0.45, 65.0],
    "basis": "model-consistent equilibrium at the existing assumed 4.0e-4 m3/s continuous-benchmark throughput"
  },
  "setpoints": {
    "initial": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0],
    "schedule": []
  },
  "disturbances": [],
  "constraints": [
    {"name": "tank_levels", "bounds": [0.0, 0.8], "unit": "m"},
    {"name": "tank_temperatures", "bounds": [0.0, 120.0], "unit": "degC"}
  ],
  "acceptance": {
    "required_checks": [
      "model_consistent_equilibrium",
      "finite_equilibrium_hold",
      "continuous_throughput_configuration",
      "seven_action_controller_contract"
    ]
  },
  "references": [
    {
      "id": "cascade-continuous-benchmark",
      "locator": "aiogym/models/tasks/builtin/cascade/continuous-benchmark.json; throughput and plant parameters are benchmark assumptions"
    }
  ]
}

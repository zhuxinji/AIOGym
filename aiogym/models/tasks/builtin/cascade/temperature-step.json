{
  "schema_version": "aiogym.task_profile.v1",
  "name": "temperature-step",
  "scenario": "cascade",
  "status": "benchmark-designed",
  "description": "Model-consistent first-stage temperature step from 35 to 40 degC and back at fixed continuous throughput.",
  "default_objective": "tracking",
  "supported_objectives": ["tracking", "kpi", "robustness", "safety"],
  "controllers": {
    "pid": {"profile": "cascade-control-benchmark"}
  },
  "environment": {
    "control_dt": 0.5,
    "episode_steps": 1600,
    "action_mode": "actuator",
    "auto_events": false,
    "randomize": false,
    "randomize_setpoints": false,
    "randomize_plant": false,
    "plant_drift": false,
    "integral_obs": false,
    "terminate_on_runaway": false,
    "noise": false,
    "noise_pct": 0.01
  },
  "operation": {
    "product_flow_sp": 0.0004,
    "min_product_flow": 0.0004
  },
  "initialization": {
    "state": [0.45, 35.0, 0.45, 50.0, 0.45, 65.0],
    "basis": "model-consistent equilibrium at the existing assumed continuous-benchmark throughput"
  },
  "setpoints": {
    "initial": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0],
    "schedule": [
      {
        "at_step": 120,
        "values": [0.45, 0.45, 0.45, 40.0, 50.0, 65.0],
        "description": "raise the first heated-stage target while retaining the downstream temperature targets"
      },
      {
        "at_step": 1200,
        "values": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0],
        "description": "return to the nominal thermal profile"
      }
    ]
  },
  "disturbances": [],
  "constraints": [
    {"name": "tank_levels", "bounds": [0.0, 0.8], "unit": "m"},
    {"name": "tank_temperatures", "bounds": [0.0, 120.0], "unit": "degC"}
  ],
  "acceptance": {
    "required_checks": [
      "setpoint_visible_before_control_step",
      "steady_state_feasible_targets",
      "finite_tracking_rollout",
      "constraint_accounting"
    ]
  },
  "references": [
    {
      "id": "cascade-continuous-benchmark",
      "locator": "Step timing and magnitude are AIO-Gym benchmark assumptions around cascade/continuous-benchmark"
    }
  ]
}

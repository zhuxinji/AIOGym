{
  "schema_version": "aiogym.benchmark_track.v1",
  "id": "cascade-economic-specialist-v1",
  "description": "Audited economic operation of the open cascade continuous benchmark.",
  "scenario": "cascade",
  "goal": "economic",
  "reward_spec": "economic-v1",
  "scorecard_spec": "process-control-v1",
  "policy_scope": "specialist",
  "policy_contract": {
    "action_mode": "actuator",
    "control_dt": 0.5,
    "disturbance_obs": true,
    "previous_action_obs": false,
    "normalize_observations": false,
    "tracking_error_obs": false,
    "case_id_obs": false
  },
  "training": {
    "cases": [
      {
        "case": "continuous-benchmark",
        "weight": 1.0
      }
    ],
    "seed_spec": {
      "namespace": "cascade-economic-training-v1"
    },
    "step_budget": 20000
  },
  "validation": {
    "cases": [
      "continuous-benchmark"
    ],
    "seed_spec": {
      "namespace": "cascade-economic-validation-v1"
    }
  },
  "test": {
    "cases": [
      {
        "case": "continuous-benchmark",
        "group": "nominal-economic"
      }
    ],
    "seed_spec": {
      "namespace": "cascade-economic-test-v1"
    }
  },
  "ranking": {
    "id": "cascade-economic-ranking-v1",
    "primary_utility": "profit_rate",
    "safety_gate": "zero-hard-failure-v1",
    "case_score": "fixed-anchor-v1",
    "track_aggregation": "arithmetic-mean-v1",
    "anchor_id": "cascade-economic-anchors-v2"
  },
  "release_audit": {
    "id": "cascade-economic-nondegeneracy-v1",
    "case": "continuous-benchmark",
    "required_nonzero_terms": [
      "product_value",
      "energy_cost"
    ],
    "status": "passed"
  }
}

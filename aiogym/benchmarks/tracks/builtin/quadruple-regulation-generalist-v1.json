{
  "schema_version": "aiogym.benchmark_track.v1",
  "id": "quadruple-regulation-generalist-v1",
  "description": "Generalist regulation policy across the two principal quadruple-tank operating regimes.",
  "scenario": "quadruple",
  "goal": "regulation",
  "reward_spec": "regulation-v1",
  "scorecard_spec": "process-control-v1",
  "policy_scope": "generalist",
  "policy_contract": {
    "action_mode": "actuator",
    "control_dt": 1.0,
    "disturbance_obs": false,
    "previous_action_obs": true,
    "normalize_observations": true,
    "tracking_error_obs": true,
    "observation_mode": "full_state",
    "temporal_observation": "single_step",
    "history_length": 1,
    "include_action_history": false,
    "recurrent_state_shape": [],
    "case_id_obs": false
  },
  "training": {
    "distribution_id": "quadruple-regulation-training-l2-v1",
    "cases": [
      {"case": "minimum-phase", "weight": 1.0},
      {"case": "nonminimum-phase", "weight": 1.0}
    ],
    "seed_spec": {"namespace": "quadruple-regulation-train-v1"},
    "step_budget": 10000
  },
  "validation": {
    "cases": ["minimum-phase", "nonminimum-phase"],
    "seed_spec": {"namespace": "quadruple-regulation-validation-v1"}
  },
  "test": {
    "cases": [
      {"case": "minimum-phase", "group": "nominal-id"},
      {"case": "nonminimum-phase", "group": "dynamics"},
      {"case": "zero-boundary-stress", "group": "stress"},
      {
        "base_case": "disturbance-rejection",
        "variant_id": "nominal",
        "overrides": {
          "disturbances": []
        },
        "group": "disturbance",
        "pair_id": "quadruple-hold-disturbance-v1",
        "base_case_id": "disturbance-rejection",
        "condition": "nominal"
      },
      {
        "case": "disturbance-rejection",
        "group": "disturbance",
        "pair_id": "quadruple-hold-disturbance-v1",
        "base_case_id": "disturbance-rejection",
        "condition": "shifted"
      }
    ],
    "seed_spec": {"namespace": "quadruple-regulation-test-v1"}
  },
  "ranking": {
    "id": "quadruple-regulation-ranking-v1",
    "primary_utility": "negative_regulation_cost_rate",
    "safety_gate": "zero-hard-failure-v1",
    "case_score": "fixed-anchor-v1",
    "track_aggregation": "weighted-geometric-mean-v1",
    "anchor_id": "quadruple-regulation-anchors-v1"
  }
}

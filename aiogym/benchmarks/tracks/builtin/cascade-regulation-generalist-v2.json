          "initialization": {"state": [0.13, 21.0, 0.13, 21.0, 0.13, 21.0], "basis": "deterministic common +0.01 m and +1 degC offset from the validated commissioning start"},
          "setpoints": {
            "initial": [0.45, 0.45, 0.45, 25.0, 30.0, 35.0],
            "schedule": [
              {"at_step": 440, "values": [0.45, 0.45, 0.45, 30.0, 40.0, 50.0], "description": "validated intermediate thermal target at a v2-specific event time"},

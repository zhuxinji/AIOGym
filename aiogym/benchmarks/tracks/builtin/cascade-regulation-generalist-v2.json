          }
        },
        "group": "reference"
      },
      {
        "base_case": "disturbance-rejection",
        "variant_id": "heldout-nominal-v2",
        "overrides": {
          "environment": {"disturbance_obs": false, "previous_action_obs": false, "normalize_observations": true, "tracking_error_obs": false},
          "initialization": {"state": [0.42, 32.0, 0.48, 53.0, 0.41, 61.0], "basis": "shared feasible offset for the v2 unmeasured-disturbance pair"},
          "disturbances": [],
          "acceptance": {"required_checks": ["deterministic_disturbance_schedule", "disturbance_hidden_from_controller", "finite_recovery_rollout", "protection_event_accounting"]}
        },
        "group": "disturbance",
        "pair_id": "cascade-unmeasured-disturbance-v2",
        "base_case_id": "disturbance-rejection",
        "condition": "nominal"

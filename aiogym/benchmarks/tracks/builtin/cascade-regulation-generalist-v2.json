        "base_case": "temperature-step",
        "variant_id": "validation-offset-v2",
        "overrides": {
          "environment": {"disturbance_obs": false, "previous_action_obs": false, "normalize_observations": true, "tracking_error_obs": false},
          "initialization": {"state": [0.47, 37.0, 0.43, 48.0, 0.46, 67.0], "basis": "deterministic moderate opposed offset for v2 validation"},
          "setpoints": {
            "initial": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0],
            "schedule": [
              {"at_step": 240, "values": [0.48, 0.44, 0.46, 38.0, 49.0, 66.0], "description": "mixed level and temperature validation step"},
              {"at_step": 960, "values": [0.44, 0.48, 0.45, 34.0, 54.0, 64.0], "description": "reversed validation step"},
              {"at_step": 1800, "values": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0], "description": "return to nominal targets"}
            ]
          }
        }
      }
    ],
    "seed_spec": {"namespace": "cascade-regulation-validation-v2"}
  },
  "test": {
    "cases": [
      {
        "base_case": "commissioning",
        "variant_id": "heldout-v2",
        "overrides": {
          "environment": {"disturbance_obs": false, "previous_action_obs": false, "normalize_observations": true, "tracking_error_obs": false},
          "initialization": {"state": [0.12, 20.0, 0.12, 20.0, 0.12, 20.0], "basis": "validated commissioning start retained because lower-inventory held-out offsets violate the zero-state-violation gate"},
          "setpoints": {
            "initial": [0.45, 0.45, 0.45, 25.0, 30.0, 35.0],
            "schedule": [
              {"at_step": 520, "values": [0.45, 0.45, 0.45, 30.0, 40.0, 50.0], "description": "validated intermediate thermal target at a held-out event time"},
              {"at_step": 1080, "values": [0.45, 0.45, 0.45, 35.0, 50.0, 65.0], "description": "validated nominal production target at a held-out event time"}

            {"at_step": 260, "name": "pump_flow_factor", "value": 0.72, "description": "28% held-out feed-pump capacity loss"},
            {"at_step": 460, "name": "pump_flow_factor", "value": 1.0, "description": "feed-pump capacity restored"},
            {"at_step": 680, "name": "heater_efficiency", "value": 0.75, "description": "25% held-out common heater efficiency loss"},
            {"at_step": 900, "name": "heater_efficiency", "value": 1.0, "description": "heater efficiency restored"},
            {"at_step": 1080, "name": "t_amb", "value": 16.0, "description": "held-out cool ambient step"},
            {"at_step": 1300, "name": "t_amb", "value": 20.0, "description": "ambient temperature restored"}
          ],
          "acceptance": {"required_checks": ["deterministic_disturbance_schedule", "disturbance_hidden_from_controller", "finite_recovery_rollout", "protection_event_accounting"]}
        },
        "group": "disturbance",
        "pair_id": "cascade-unmeasured-disturbance-v2",
        "base_case_id": "disturbance-rejection",
        "condition": "shifted"
